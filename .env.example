# Local verification API port; keep in sync with miniprogram/config/verification.js.
PORT=8787

# Resend credentials and a sender address configured in your Resend account.
RESEND_API_KEY=
EMAIL_FROM=

# WECHAT_APP_ID defaults to the appid in project.config.json when left empty.
WECHAT_APP_ID=
# Fill in the AppSecret for that mini program. Keep this value server-side only.
WECHAT_APP_SECRET=
