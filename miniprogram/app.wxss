page {
  background: #f7f5f2;
  color: #292326;
  font-family: "Avenir Next", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
}
view, text, scroll-view, swiper, swiper-item, button, input { box-sizing: border-box; }
button { margin: 0; padding: 0; background: transparent; color: inherit; line-height: 1.4; font-family: inherit; border-radius: 0; }
button::after { border: none; }
.page-shell { min-height: 100vh; padding: 32rpx 32rpx 64rpx; }
.section-heading { font-size: 34rpx; font-weight: 700; letter-spacing: 0; line-height: 1.4; }
.section-copy { display: block; margin-top: 8rpx; font-size: 24rpx; line-height: 1.6; color: #82777c; }
.panel { background: #ffffff; border: 1rpx solid #ece7e8; border-radius: 24rpx; box-shadow: 0 6rpx 24rpx rgba(55, 28, 38, 0.025); }
.chip { display: inline-flex; align-items: center; justify-content: center; padding: 10rpx 20rpx; border-radius: 12rpx; background: #f6e9ed; color: #821e3c; font-size: 22rpx; font-weight: 600; }
.muted { color: #82777c; }
.eyebrow { display: block; font-size: 19rpx; font-weight: 600; letter-spacing: 2rpx; color: #82777c; }
.section-head-row { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.text-link { color: #821e3c; font-size: 23rpx; font-weight: 500; flex-shrink: 0; padding: 10rpx 0 10rpx 14rpx; }
.link-arrow { margin-left: 6rpx; font-size: 30rpx; }
.language-toolbar { display: flex; justify-content: flex-end; margin: -8rpx 0 16rpx; }
.language-switch { display: flex; align-items: center; justify-content: center; min-height: 76rpx; padding: 14rpx 22rpx; border: 1rpx solid #e9e1e4; border-radius: 14rpx; background: #fff; color: #821e3c; font-size: 24rpx; font-weight: 600; }
