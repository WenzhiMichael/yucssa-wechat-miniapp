<view class="page-shell contact-page">
  <view class="language-toolbar"><button class="language-switch" bindtap="toggleLanguage" aria-label="{{ui.common.switchLanguage}}">{{language === 'zh' ? 'English' : '中文'}}</button></view>
  <view class="contact-hero panel">
    <text class="contact-kicker">{{ui.contact.kicker}}</text>
    <text class="contact-title">{{ui.contact.title}}</text>
    <text class="contact-copy">
      {{ui.contact.copy}}
    </text>
  </view>

  <view class="contact-section">
    <text class="section-heading">{{ui.contact.contact}}</text>
    <view class="contact-list">
      <block wx:for="{{supportChannels}}" wx:key="id">
        <view class="contact-card panel">
          <view class="contact-copy-block">
            <text class="contact-label">{{item.label}}</text>
            <text class="contact-value">{{item.value}}</text>
            <text class="contact-description">{{item.description}}</text>
          </view>
          <button class="contact-button" bindtap="copyValue" data-value="{{item.value}}">{{ui.common.copy}}</button>
        </view>
      </block>
    </view>
  </view>

  <view class="contact-section">
    <text class="section-heading">{{ui.contact.join}}</text>
    <text class="section-copy">{{ui.contact.joinCopy}}</text>

    <view class="join-list">
      <block wx:for="{{joinOpportunities}}" wx:key="id">
        <view class="join-card panel">
          <text class="join-title">{{item.title}}</text>
          <text class="join-description">{{item.description}}</text>
          <text class="join-meta">{{item.cadence}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="contact-section">
    <text class="section-heading">{{ui.contact.updates}}</text>
    <text class="section-copy">
      {{ui.contact.updatesCopy}}
    </text>

    <view class="official-card panel">
      <text class="official-title">{{ui.contact.official}}</text>
      <text class="official-copy">{{ui.contact.officialCopy}}</text>
      <official-account></official-account>
    </view>
  </view>
</view>
