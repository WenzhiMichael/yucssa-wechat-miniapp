.contact-page {
  background: #f7f5f2;
}

.contact-hero {
  padding: 34rpx 28rpx;
  background: linear-gradient(120deg, #66142f, #8c2545);
}

.contact-kicker {
  display: inline-block;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #f7f5ef;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.contact-title {
  display: block;
  margin-top: 24rpx;
  font-family: inherit;
  font-size: 44rpx;
  line-height: 1.18;
  color: #f7f5ef;
}

.contact-copy {
  display: block;
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(247, 245, 239, 0.86);
}

.contact-section {
  margin-top: 30rpx;
}

.contact-list,
.join-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.contact-card,
.join-card,
.official-card {
  padding: 26rpx;
}

.contact-card {
  display: flex;
  align-items: center;
}

.contact-copy-block {
  flex: 1;
  padding-right: 16rpx;
}

.contact-label,
.join-title,
.official-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #292326;
}

.contact-value,
.join-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #821e3c;
  font-weight: 700;
}

.contact-description,
.join-description,
.official-copy {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #82777c;
}

.contact-button {
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: #821e3c;
  color: #f7f5f2;
  font-size: 22rpx;
  font-weight: 700;
}

.official-card {
  margin-top: 20rpx;
}

.contact-copy-block { min-width: 0; }
.contact-value { word-break: break-word; }
.contact-button { flex-shrink: 0; }
