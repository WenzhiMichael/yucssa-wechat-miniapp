.home-page { padding-bottom: 200rpx; }
.home-header { display: flex; align-items: center; justify-content: space-between; margin: 4rpx 0 30rpx; }
.home-greeting { display: block; margin-top: 10rpx; font-size: 38rpx; font-weight: 700; line-height: 1.4; }
.avatar-button { width: 80rpx; height: 80rpx; flex-shrink: 0; margin-left: 20rpx; border: 5rpx solid #fff; border-radius: 50%; background: #eee1e5; color: #821e3c; overflow: hidden; display: flex; align-items: center; justify-content: center; }
.avatar-image { width: 100%; height: 100%; }
.avatar-fallback { font-size: 30rpx; font-weight: 700; }
.member-card { position: relative; overflow: hidden; padding: 32rpx; border-radius: 28rpx; color: #fff9f5; background: linear-gradient(120deg, #66142f 0%, #8c2545 72%, #9e3a50 100%); box-shadow: 0 16rpx 30rpx rgba(105, 21, 48, 0.15); }
.card-watermark { position: absolute; right: -15rpx; top: 60rpx; font-family: Georgia, serif; font-size: 250rpx; font-weight: 700; line-height: 1; letter-spacing: -24rpx; color: rgba(255, 240, 223, 0.045); transform: rotate(-12deg); }
.member-card-top, .member-card-bottom { position: relative; display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.member-brand { display: block; font-size: 35rpx; font-weight: 700; letter-spacing: 3rpx; }
.member-association { display: block; margin-top: 4rpx; font-size: 18rpx; color: #e9cbd5; }
.member-status { padding: 8rpx 14rpx; border-radius: 10rpx; border: 1rpx solid rgba(233, 203, 213, 0.35); font-size: 20rpx; color: #f1d9b1; flex-shrink: 0; }
.member-card-body { position: relative; margin: 38rpx 0 32rpx; }
.member-card-caption { display: block; font-size: 16rpx; letter-spacing: 2.5rpx; color: #e3bc99; }
.member-card-title { display: block; font-size: 40rpx; font-weight: 600; margin-top: 10rpx; letter-spacing: 1rpx; }
.member-card-bottom { padding-top: 24rpx; border-top: 1rpx solid rgba(255, 255, 255, 0.15); align-items: flex-end; }
.member-block { min-width: 0; flex: 1; }
.member-label { display: block; font-size: 19rpx; color: #e9cbd5; }
.member-code { display: block; margin-top: 8rpx; font-size: 32rpx; letter-spacing: 2rpx; font-weight: 600; word-break: break-all; }
.member-button { padding: 13rpx 18rpx; border-radius: 12rpx; background: #f3dfbe; color: #68152f; font-size: 22rpx; font-weight: 600; flex-shrink: 0; }
.wallet-strip { width: 100%; display: flex; align-items: center; padding: 22rpx 4rpx; text-align: left; gap: 14rpx; }
.wallet-icon { position: relative; width: 34rpx; height: 27rpx; border-radius: 5rpx; background: #40343a; border-top: 6rpx solid #c4a079; }
.wallet-icon view { position: absolute; right: -2rpx; top: 5rpx; width: 15rpx; height: 12rpx; border: 2rpx solid #f7f5f2; border-radius: 3rpx; }
.wallet-label { flex: 1; font-size: 23rpx; color: #66595f; }
.wallet-status { font-size: 20rpx; color: #8c7e84; padding: 5rpx 10rpx; background: #ece8e5; border-radius: 8rpx; }
.home-section { margin-top: 30rpx; }
.category-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 22rpx 0; gap: 16rpx; }
.category-item { display: flex; align-items: center; justify-content: center; gap: 12rpx; padding: 20rpx 8rpx; border: 1rpx solid #ece7e8; border-radius: 18rpx; background: #fff; }
.category-badge { width: 60rpx; height: 60rpx; flex-shrink: 0; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; font-weight: 600; }
.category-title { font-size: 23rpx; font-weight: 600; }
.featured-list { display: flex; flex-direction: column; gap: 14rpx; }
.featured-card { width: 100%; display: flex; align-items: center; padding: 22rpx; text-align: left; gap: 20rpx; }
.featured-logo { width: 84rpx; height: 84rpx; border: 1rpx solid #f0e9eb; border-radius: 18rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: #821e3c; }
.featured-logo image { width: 66rpx; height: 66rpx; }
.featured-copy { flex: 1; min-width: 0; }
.featured-name { display: -webkit-box; overflow: hidden; -webkit-line-clamp: 1; -webkit-box-orient: vertical; font-size: 26rpx; font-weight: 600; line-height: 1.5; }
.featured-offer { display: block; margin-top: 7rpx; font-size: 23rpx; color: #821e3c; font-weight: 600; }
.featured-arrow { font-size: 34rpx; color: #b0a2a8; }
.event-list { display: flex; flex-direction: column; gap: 14rpx; margin-top: 22rpx; }
.event-card { width: 100%; display: flex; align-items: flex-start; padding: 22rpx; text-align: left; }
.event-date { width: 84rpx; flex-shrink: 0; padding: 12rpx 8rpx; border-radius: 15rpx; background: #f7edf0; text-align: center; color: #821e3c; }
.event-month { display: block; font-size: 18rpx; font-weight: 600; letter-spacing: 1rpx; }
.event-day { display: block; margin-top: 2rpx; font-size: 36rpx; font-weight: 700; line-height: 1.2; }
.event-copy-block { flex: 1; min-width: 0; margin-left: 20rpx; }
.event-title-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 8rpx; }
.event-title { font-size: 27rpx; font-weight: 600; }
.event-status { padding: 4rpx 9rpx; background: #f4eee5; color: #806240; border-radius: 6rpx; font-size: 18rpx; flex-shrink: 0; }
.event-meta, .event-note { display: block; margin-top: 7rpx; font-size: 21rpx; line-height: 1.6; color: #82777c; }
.community-strip { width: 100%; margin-top: 30rpx; padding: 26rpx; background: #ece5e2; border-radius: 22rpx; display: flex; justify-content: space-between; align-items: center; text-align: left; }
.community-title { display: block; color: #68152f; font-size: 29rpx; font-weight: 600; }
.community-copy { display: block; margin-top: 8rpx; font-size: 21rpx; color: #82777c; }
.community-arrow { font-size: 40rpx; color: #821e3c; }
.home-footer { display: block; margin-top: 32rpx; text-align: center; font-size: 17rpx; letter-spacing: 2rpx; color: #a89aa0; }
.home-dock { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); padding: 19rpx 24rpx 24rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #ece7e8; }
.dock-item { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9rpx; color: #9d9197; font-size: 20rpx; }
.dock-active { color: #821e3c; font-weight: 600; }
.nav-icon { position: relative; width: 34rpx; height: 30rpx; margin-top: 7rpx; color: inherit; }
.icon-home { width: 28rpx; height: 25rpx; border: 2.5rpx solid currentColor; border-top: 0; border-radius: 2rpx; }
.icon-home::before { content: ''; position: absolute; width: 21rpx; height: 21rpx; left: 0; top: -10rpx; border-left: 2.5rpx solid currentColor; border-top: 2.5rpx solid currentColor; transform: rotate(45deg); border-radius: 2rpx; }
.icon-home::after { content: ''; position: absolute; width: 8rpx; height: 12rpx; left: 8rpx; bottom: -1rpx; border: 2rpx solid currentColor; border-bottom: 0; }
.icon-shop { border: 2rpx solid currentColor; border-radius: 3rpx; height: 25rpx; margin-top: 12rpx; }
.icon-shop::before { content: ''; position: absolute; left: -5rpx; top: -9rpx; width: 40rpx; height: 10rpx; border: 2rpx solid currentColor; background: #fff; border-radius: 5rpx 5rpx 3rpx 3rpx; }
.icon-shop::after { content: ''; position: absolute; bottom: 0; left: 11rpx; width: 9rpx; height: 12rpx; border: 2rpx solid currentColor; border-bottom: 0; }
.icon-calendar { border: 2rpx solid currentColor; border-radius: 5rpx; }
.icon-calendar::before { content: ''; position: absolute; left: 0; right: 0; top: 7rpx; border-top: 2rpx solid currentColor; }
.icon-calendar::after { content: ''; position: absolute; width: 13rpx; height: 6rpx; border-left: 2rpx solid currentColor; border-right: 2rpx solid currentColor; left: 8rpx; top: -6rpx; }
.icon-member { border: 2rpx solid currentColor; border-radius: 50% 50% 4rpx 4rpx; height: 17rpx; margin-top: 20rpx; }
.icon-member::before { content: ''; position: absolute; width: 14rpx; height: 14rpx; border: 2rpx solid currentColor; border-radius: 50%; left: 7rpx; top: -20rpx; }
.member-card-title { font-size: 36rpx; line-height: 1.35; }
.member-card-top > view { flex: 1; min-width: 0; }
.member-association { line-height: 1.5; }
.category-title { min-width: 0; font-size: 21rpx; line-height: 1.4; }
.event-title { min-width: 0; }
.event-status { flex-shrink: 1; max-width: 150rpx; text-align: center; }
