<view class="page-shell login-page">
  <view class="language-toolbar"><button class="language-switch" bindtap="toggleLanguage" aria-label="{{ui.common.switchLanguage}}">{{language === 'zh' ? 'English' : '中文'}}</button></view>
  <view class="welcome-card">
    <view class="brand-mark">YU</view>
    <text class="brand-name">{{ui.login.brand}}</text>
    <view class="welcome-title">
      <text class="welcome-title-line">{{ui.login.titleLine1}}</text>
      <text class="welcome-title-line">{{ui.login.titleLine2}}</text>
    </view>
    <text class="welcome-copy">{{ui.login.intro}}</text>
    <view class="welcome-tags">
      <text class="welcome-tag">{{ui.login.identity}}</text>
      <text class="welcome-tag">{{ui.login.benefits}}</text>
      <text class="welcome-tag">{{ui.login.events}}</text>
    </view>
  </view>

  <view class="login-card panel">
    <text class="login-title">{{ui.login.title}}</text>
    <text class="login-copy">{{ui.login.copy}}</text>
    <view class="login-field">
      <text class="field-label">{{ui.login.email}}</text>
      <input class="login-input" type="text" maxlength="64"
        placeholder="{{ui.login.emailPlaceholder}}" placeholder-class="input-placeholder"
        value="{{verificationEmailInput}}" bindinput="handleVerificationEmailInput"
        disabled="{{isSendingCode || isVerifyingCode}}" />
      <text class="field-help">{{ui.login.emailHelp}}</text>
    </view>
    <view class="login-field">
      <text class="field-label">{{ui.login.code}}</text>
      <view class="code-row">
        <input class="login-input code-input" type="number" maxlength="6"
          placeholder="{{ui.login.codePlaceholder}}" placeholder-class="input-placeholder"
          value="{{verificationCodeInput}}" bindinput="handleVerificationCodeInput"
          disabled="{{verificationStatus !== 'pending' || isVerifyingCode}}" />
        <button class="send-code-button" bindtap="sendVerificationCode" loading="{{isSendingCode}}"
          disabled="{{!verificationEmailInput || isSendingCode || isVerifyingCode}}"
        >{{verificationStatus === 'pending' ? ui.login.resend : ui.login.send}}</button>
      </view>
    </view>
    <view class="login-status">
      <view class="status-dot {{verificationStatus === 'pending' ? 'status-dot-pending' : ''}}"></view>
      <text class="status-copy">{{verificationHint}}</text>
    </view>
    <button class="login-button" bindtap="submitLogin" loading="{{isVerifyingCode}}"
      disabled="{{isSendingCode || isVerifyingCode || (verificationStatus !== 'verified' && (verificationStatus !== 'pending' || verificationCodeInput.length !== 6))}}"
    >{{isVerifyingCode ? ui.login.signingIn : ui.login.signIn}}</button>
    <button wx:if="{{canUseProfile}}" class="profile-button" bindtap="handleProfileLogin"
      disabled="{{isSendingCode || isVerifyingCode}}"
    >{{hasAuthorizedProfile ? ui.login.profileSelected + profilePreviewName : ui.login.useProfile}}</button>
    <text class="login-note">{{ui.login.profileNote}}</text>
    <view wx:if="{{canPreview}}" class="preview-entry">
      <button class="preview-entry-button" bindtap="handlePreviewLogin"
        disabled="{{isSendingCode || isVerifyingCode}}">{{ui.login.preview}}</button>
      <text class="login-note">{{ui.login.previewNote}}</text>
    </view>
  </view>
  <text class="login-footer">{{ui.login.footer}}</text>
</view>
