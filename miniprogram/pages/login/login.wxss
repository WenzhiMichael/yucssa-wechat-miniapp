.login-page {
  padding-top: 24rpx;
  background: radial-gradient(circle at top left, rgba(196, 81, 53, 0.12), transparent 36%),
    linear-gradient(180deg, #f2ebe2 0%, #f8f4ee 50%, #f3eee5 100%);
}
.welcome-card {
  position: relative;
  overflow: hidden;
  padding: 34rpx 36rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #73171b, #9c302c 60%, #b76342);
  color: #fff8f2;
}
.brand-mark {
  position: absolute;
  right: 30rpx;
  top: 28rpx;
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid rgba(255, 248, 240, 0.36);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}
.brand-name {
  display: block;
  padding-right: 80rpx;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: rgba(255, 248, 240, 0.85);
}
.welcome-title {
  display: block;
  margin-top: 26rpx;
  font-family: "Times New Roman", "Songti SC", serif;
  font-size: 50rpx;
  line-height: 1.3;
  font-weight: 700;
}
.welcome-copy {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: rgba(255, 248, 240, 0.86);
}
.welcome-title-line { display: block; }
.welcome-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}
.welcome-tag {
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 248, 240, 0.14);
  font-size: 21rpx;
}
.login-card {
  margin-top: 24rpx;
  padding: 32rpx 28rpx 26rpx;
}
.login-title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #241813;
}
.login-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #70635a;
}
.login-field { margin-top: 26rpx; }
.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #44362c;
}
.login-input {
  width: 100%;
  height: 92rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(96, 66, 49, 0.14);
  border-radius: 20rpx;
  background: #fffdf9;
  color: #241813;
  font-size: 28rpx;
}
.input-placeholder { color: #998b80; }
.field-help {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7b6f66;
}
.code-row { display: flex; align-items: center; gap: 16rpx; }
.code-input { flex: 1; width: 0; min-width: 0; }
.send-code-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 190rpx;
  height: 92rpx;
  padding: 0 20rpx;
  border-radius: 20rpx;
  background: #f1e4d8;
  color: #73171b;
  font-size: 25rpx;
  font-weight: 600;
}
.send-code-button[disabled] { color: #998b80; background: #f2ece5; }
.login-status { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 20rpx; }
.status-dot {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  margin-top: 13rpx;
  border-radius: 50%;
  background: #998b80;
}
.status-dot-pending { background: #1d6a5d; }
.status-copy {
  flex: 1;
  min-width: 0;
  word-break: break-all;
  font-size: 23rpx;
  line-height: 1.65;
  color: #70635a;
}
.login-button {
  width: 100%;
  padding: 28rpx 20rpx;
  margin-top: 26rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #892025, #b95c3f);
  color: #fffaf5;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}
.login-button[disabled] { background: #e3d8ce; color: #998b80; }
.profile-button {
  width: 100%;
  padding: 22rpx 12rpx;
  margin-top: 8rpx;
  color: #73171b;
  font-size: 24rpx;
  text-align: center;
}
.login-note {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7b6f66;
  text-align: center;
}
.login-footer {
  display: block;
  margin: 26rpx 10rpx 0;
  font-size: 21rpx;
  line-height: 1.6;
  color: #8a7b70;
  text-align: center;
}
.preview-entry {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(96, 66, 49, 0.12);
}
.preview-entry-button {
  width: 100%;
  padding: 24rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: 22rpx;
  background: #f1e4d8;
  color: #73171b;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}
