.detail-page {
  background: #f7f5f2;
}

.detail-hero {
  padding: 34rpx 28rpx;
  background: #fff;
}

.detail-badge {
  width: 108rpx;
  height: 108rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 800;
}

.detail-badge-image {
  width: 72rpx;
  height: 72rpx;
}

.detail-name {
  display: block;
  margin-top: 24rpx;
  font-family: inherit;
  font-size: 44rpx;
  font-weight: 700;
  color: #292326;
}

.detail-meta,
.detail-description {
  display: block;
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #82777c;
}

.detail-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 28rpx;
}

.detail-action {
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: #f6e9ed;
  color: #821e3c;
  font-size: 23rpx;
  font-weight: 700;
}

.primary-action {
  background: #821e3c;
  color: #fff9f2;
}

.offer-card,
.info-card,
.steps-card,
.tag-card {
  margin-top: 22rpx;
  padding: 28rpx 26rpx;
}

.offer-label {
  display: inline-block;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  background: #f7edf0;
  color: #821e3c;
  font-size: 21rpx;
  font-weight: 700;
}

.offer-title {
  display: block;
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #292326;
}

.offer-copy {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.75;
  color: #82777c;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.info-label {
  min-width: 88rpx;
  font-size: 23rpx;
  color: #82777c;
}

.info-value,
.info-link {
  flex: 1;
  text-align: right;
  font-size: 25rpx;
  line-height: 1.7;
  color: #292326;
}

.info-link {
  color: #821e3c;
  font-weight: 700;
}

.info-divider {
  height: 1rpx;
  background: rgba(70, 47, 34, 0.08);
  margin: 22rpx 0;
}

.steps-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #292326;
}

.step-row {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
}

.step-index {
  width: 74rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #821e3c;
}

.step-copy {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.7;
  color: #82777c;
}

.tag-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.detail-tag {
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: #f7edf0;
  color: #821e3c;
  font-size: 21rpx;
  font-weight: 700;
}

.detail-tag-secondary {
  background: #f7edf0;
  color: #821e3c;
}

.related-section {
  margin-top: 30rpx;
}

.related-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.related-card {
  display: flex;
  align-items: center;
  padding: 22rpx;
  text-align: left;
}

.related-mark {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
}

.related-mark-image {
  width: 52rpx;
  height: 52rpx;
}

.related-copy-block {
  flex: 1;
  margin-left: 16rpx;
}

.related-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #292326;
}

.related-copy {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #82777c;
}

.detail-name { font-size: 40rpx; line-height: 1.4; word-break: break-word; }
.offer-card { position: relative; overflow: hidden; background: #fcf6f8; border: 1rpx dashed #d9b6c2; box-shadow: none; }
.offer-label { padding: 0; background: transparent; font-size: 20rpx; letter-spacing: 1rpx; }
.offer-title { font-size: 40rpx; color: #821e3c; }
.detail-badge, .related-mark { flex-shrink: 0; }
.related-copy-block { min-width: 0; }
.info-value { word-break: break-word; }
