<view wx:if="{{profile}}" class="page-shell profile-page">
  <view class="language-toolbar"><button class="language-switch" bindtap="toggleLanguage" aria-label="{{ui.common.switchLanguage}}">{{language === 'zh' ? 'English' : '中文'}}</button></view>
  <view class="profile-card panel">
    <view class="profile-top">
      <view class="profile-avatar">
        <image
          wx:if="{{profile.avatarUrl}}"
          class="profile-avatar-image"
          src="{{profile.avatarUrl}}"
          mode="aspectFill"
        ></image>
        <text wx:else class="profile-avatar-text">{{profileInitial}}</text>
      </view>

      <view class="profile-copy-block">
        <text class="profile-name">{{profile.nickName}}</text>
        <text class="profile-membership">{{profile.membershipLevel}} · {{profile.joinedLabel}}</text>
        <text class="profile-bio">{{profile.bio}}</text>
      </view>
    </view>

    <view class="profile-meta-grid">
      <view class="profile-meta-card">
        <text class="profile-meta-label">{{ui.profile.organization}}</text>
        <text class="profile-meta-value">{{profile.faculty}}</text>
      </view>
      <view class="profile-meta-card">
        <text class="profile-meta-label">{{ui.profile.code}}</text>
        <text class="profile-meta-value">{{profile.memberCode}}</text>
      </view>
    </view>

    <button class="profile-main-button" bindtap="copyMemberCode">{{ui.profile.copyCode}}</button>
  </view>

  <view class="profile-section">
    <text class="section-heading">{{ui.profile.verification}}</text>
    <view class="verification-card panel">
      <view class="verification-head">
        <view class="verification-copy-block">
          <text class="verification-title">{{verificationTitle}}</text>
          <text class="verification-copy">{{verificationCopy}}</text>
        </view>
        <text
          class="verification-badge {{profile.verificationStatus === 'verified' ? 'verification-badge-verified' : ''}}"
        >
          {{verificationBadgeText}}
        </text>
      </view>
    </view>
  </view>

  <view class="profile-section">
    <text class="section-heading">{{ui.profile.contact}}</text>
    <view class="channel-list">
      <block wx:for="{{supportChannels}}" wx:key="id">
        <view class="channel-card panel">
          <view class="channel-copy-block">
            <text class="channel-label">{{item.label}}</text>
            <text class="channel-value">{{item.value}}</text>
            <text class="channel-description">{{item.description}}</text>
          </view>
          <button class="channel-button" bindtap="copyChannel" data-value="{{item.value}}">{{ui.common.copy}}</button>
        </view>
      </block>
    </view>
  </view>

  <button class="logout-button" bindtap="logout">{{ui.profile.logout}}</button>
</view>
