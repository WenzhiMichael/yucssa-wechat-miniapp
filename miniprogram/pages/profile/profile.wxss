.profile-page {
  background: #f7f5f2;
}

.profile-card {
  padding: 30rpx 28rpx;
  background: #fff;
}

.profile-top {
  display: flex;
  align-items: flex-start;
}

.profile-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 24rpx;
  background: #821e3c;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.profile-avatar-image {
  width: 100%;
  height: 100%;
}

.profile-avatar-text {
  color: #fff8f2;
  font-size: 40rpx;
  font-weight: 800;
}

.profile-copy-block {
  flex: 1;
  margin-left: 20rpx;
}

.profile-name {
  display: block;
  font-family: inherit;
  font-size: 40rpx;
  font-weight: 700;
  color: #292326;
}

.profile-membership,
.profile-bio {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #82777c;
}

.profile-meta-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.profile-meta-card {
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
}

.profile-meta-label {
  display: block;
  font-size: 22rpx;
  color: #82777c;
}

.profile-meta-value {
  display: block;
  margin-top: 12rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #292326;
}

.profile-main-button {
  width: 100%;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #821e3c;
  color: #fff8f2;
  font-size: 27rpx;
  font-weight: 700;
}

.profile-section {
  margin-top: 30rpx;
}

.verification-card {
  margin-top: 20rpx;
  padding: 28rpx 26rpx;
  background: #fff;
}

.verification-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.verification-copy-block {
  flex: 1;
}

.verification-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #292326;
}

.verification-copy {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #82777c;
}

.verification-badge {
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(125, 29, 32, 0.1);
  color: #821e3c;
  font-size: 22rpx;
  font-weight: 700;
}

.verification-badge-verified {
  background: rgba(29, 106, 93, 0.12);
  color: #1d6a5d;
}

.channel-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.channel-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
}

.channel-copy-block {
  flex: 1;
  margin-left: 16rpx;
  text-align: left;
}

.channel-label {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  color: #292326;
}

.channel-value,
.channel-description {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #82777c;
}

.channel-button {
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #821e3c;
  color: #fff8f2;
  font-size: 22rpx;
  font-weight: 700;
}

.logout-button {
  width: 100%;
  margin-top: 34rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #f6e9ed;
  color: #821e3c;
  font-size: 26rpx;
  font-weight: 700;
}

.profile-avatar { flex-shrink: 0; border-radius: 50%; }
.profile-copy-block, .channel-copy-block { min-width: 0; }
.profile-meta-value, .verification-copy, .channel-value { word-break: break-word; }
.profile-main-button, .logout-button { border-radius: 16rpx; }
.channel-button { flex-shrink: 0; }
