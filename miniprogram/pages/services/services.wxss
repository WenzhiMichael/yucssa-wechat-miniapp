.services-page {
  background: #f7f5f2;
}

.services-hero {
  padding: 34rpx 28rpx;
  background: linear-gradient(120deg, #66142f, #8c2545);
}

.services-kicker {
  display: inline-block;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #f8f7f2;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.services-title {
  display: block;
  margin-top: 24rpx;
  font-family: inherit;
  font-size: 44rpx;
  line-height: 1.18;
  color: #f8f7f2;
}

.services-copy {
  display: block;
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(248, 247, 242, 0.86);
}

.services-section {
  margin-top: 30rpx;
}

.notice-list,
.timeline-list,
.channel-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.notice-card,
.support-card,
.timeline-card,
.channel-card {
  padding: 26rpx;
}

.notice-label {
  display: inline-block;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: #f7edf0;
  color: #821e3c;
  font-size: 21rpx;
  font-weight: 700;
}

.notice-title,
.support-name,
.timeline-title,
.channel-label {
  display: block;
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #292326;
}

.notice-copy,
.support-copy,
.timeline-note,
.channel-description {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #82777c;
}

.timeline-card {
  display: flex;
  align-items: flex-start;
}

.timeline-date {
  width: 110rpx;
  padding: 18rpx 10rpx;
  border-radius: 24rpx;
  background: #821e3c;
  text-align: center;
}

.timeline-month,
.timeline-day {
  display: block;
  color: #f8f7f2;
  font-weight: 700;
}

.timeline-month {
  font-size: 22rpx;
}

.timeline-day {
  margin-top: 8rpx;
  font-size: 40rpx;
}

.timeline-copy-block {
  flex: 1;
  margin-left: 20rpx;
}

.timeline-meta,
.support-meta,
.channel-value {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #82777c;
}

.timeline-status {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #821e3c;
  font-weight: 700;
}

.support-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.channel-card {
  display: flex;
  align-items: center;
}

.channel-copy-block {
  flex: 1;
  padding-right: 16rpx;
}

.channel-button {
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: #821e3c;
  color: #f8f7f2;
  font-size: 22rpx;
  font-weight: 700;
}

.timeline-date { flex-shrink: 0; width: 88rpx; border-radius: 16rpx; background: #f7edf0; }
.timeline-month, .timeline-day { color: #821e3c; }
.timeline-copy-block { min-width: 0; }
.timeline-title { margin-top: 0; }
.timeline-status { flex-shrink: 0; font-size: 19rpx; padding: 5rpx 8rpx; border-radius: 6rpx; background: #f4eee5; color: #806240; }
.channel-copy-block { min-width: 0; }
.channel-value { word-break: break-all; line-height: 1.6; }
.channel-button { flex-shrink: 0; }
.timeline-status { flex-shrink: 1; max-width: 136rpx; text-align: center; }
.timeline-copy-block { flex-basis: 0; }
